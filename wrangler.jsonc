{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mot",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "build": {
    "command": "bundle install && bundle exec jekyll build -d _site/mot"
  },
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
